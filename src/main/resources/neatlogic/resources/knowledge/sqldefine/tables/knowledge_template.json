{
  "moduleId": "knowledge",
  "name": "knowledge_template",
  "label": "知识库模版",
  "description": "知识库模版 可用于知识库相关的启用状态筛选、时间维度统计等报表查询场景。",
  "fields": [
    {
      "name": "id",
      "type": "bigint",
      "description": "主键ID，作为当前表记录的主键或唯一定位字段。"
    },
    {
      "name": "name",
      "type": "varchar(50)",
      "description": "模版名称。"
    },
    {
      "name": "content",
      "type": "longtext",
      "description": "目录。"
    },
    {
      "name": "is_active",
      "type": "tinyint",
      "description": "是否激活。"
    },
    {
      "name": "fcu",
      "type": "char(32)",
      "description": "创建人ID。"
    },
    {
      "name": "lcu",
      "type": "char(32)",
      "description": "更新人ID。"
    },
    {
      "name": "fcd",
      "type": "timestamp(3)",
      "description": "创建时间。"
    },
    {
      "name": "lcd",
      "type": "timestamp(3)",
      "description": "更新时间，已建立普通索引，适合用于过滤、关联或排序查询。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ],
      "description": "主键索引，覆盖 id 字段，适合用于唯一定位记录和主表关联查询。"
    },
    {
      "name": "idx_lcd",
      "type": "BTREE",
      "unique": false,
      "primary": false,
      "columns": [
        "lcd"
      ],
      "description": "普通索引，覆盖 lcd 字段，适合用于过滤、关联或排序查询。"
    }
  ]
}
