<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="neatlogic.framework.knowledge.dao.mapper.KnowledgeFeishuSyncMapper">

    <select id="searchConfigCount" resultType="int">
        SELECT COUNT(1)
        FROM `knowledge_feishu_sync_config`
        <where>
            <if test="keyword != null and keyword != ''">
                AND `name` LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
    </select>

    <select id="searchConfig" resultType="neatlogic.framework.knowledge.dto.feishu.KnowledgeFeishuSyncConfigVo">
        SELECT kfsc.`id`,
               kfsc.`name`,
               kfsc.`app_id` AS appId,
               kfsc.`knowledge_circle_id` AS knowledgeCircleId,
               kc.`name` AS knowledgeCircleName,
               kfsc.`is_active` AS isActive,
               kfsc.`fcu`,
               kfsc.`fcd`,
               kfsc.`lcu`,
               kfsc.`lcd`
        FROM `knowledge_feishu_sync_config` kfsc
        LEFT JOIN `knowledge_circle` kc ON kc.`id` = kfsc.`knowledge_circle_id`
        <where>
            <if test="keyword != null and keyword != ''">
                AND kfsc.`name` LIKE CONCAT('%', #{keyword}, '%')
            </if>
        </where>
        ORDER BY kfsc.`lcd` DESC
        <if test="needPage">
            LIMIT #{startNum}, #{pageSize}
        </if>
    </select>

    <select id="getConfigById" resultType="neatlogic.framework.knowledge.dto.feishu.KnowledgeFeishuSyncConfigVo">
        SELECT `id`,
               `name`,
               `app_id` AS appId,
               `app_secret` AS appSecret,
               `knowledge_circle_id` AS knowledgeCircleId,
               `is_active` AS isActive,
               `fcu`,
               `fcd`,
               `lcu`,
               `lcd`
        FROM `knowledge_feishu_sync_config`
        WHERE `id` = #{value}
    </select>

    <select id="getConfigByName" resultType="neatlogic.framework.knowledge.dto.feishu.KnowledgeFeishuSyncConfigVo">
        SELECT `id`, `name`
        FROM `knowledge_feishu_sync_config`
        WHERE `name` = #{value}
    </select>

    <select id="checkNameIsRepeat" resultType="int">
        SELECT COUNT(1)
        FROM `knowledge_feishu_sync_config`
        WHERE `name` = #{name}
        <if test="id != null">
            AND `id` != #{id}
        </if>
    </select>

    <insert id="insertConfig">
        INSERT INTO `knowledge_feishu_sync_config`
        (`id`, `name`, `app_id`, `app_secret`, `knowledge_circle_id`, `is_active`, `fcu`, `fcd`, `lcu`, `lcd`)
        VALUES
        (#{id}, #{name}, #{appId}, #{appSecret}, #{knowledgeCircleId}, #{isActive}, #{fcu}, NOW(3), #{lcu}, NOW(3))
    </insert>

    <update id="updateConfig">
        UPDATE `knowledge_feishu_sync_config`
        SET `name` = #{name},
            `app_id` = #{appId},
            <if test="appSecret != null and appSecret != ''">
                `app_secret` = #{appSecret},
            </if>
            `knowledge_circle_id` = #{knowledgeCircleId},
            `is_active` = #{isActive},
            `lcu` = #{lcu},
            `lcd` = NOW(3)
        WHERE `id` = #{id}
    </update>

    <update id="updateConfigStatus">
        UPDATE `knowledge_feishu_sync_config`
        SET `is_active` = #{isActive},
            `lcu` = #{lcu},
            `lcd` = NOW(3)
        WHERE `id` = #{id}
    </update>

    <delete id="deleteConfig">
        DELETE FROM `knowledge_feishu_sync_config`
        WHERE `id` = #{value}
    </delete>

    <insert id="insertAudit">
        INSERT INTO `knowledge_feishu_sync_audit`
        (`id`, `config_id`, `direction`, `status`, `total_count`, `success_count`, `failed_count`, `error`, `detail`, `fcu`, `fcd`, `start_time`)
        VALUES
        (#{id}, #{configId}, #{direction}, #{status}, #{totalCount}, #{successCount}, #{failedCount}, #{error}, #{detailStr}, #{fcu}, NOW(3), NOW(3))
    </insert>

    <update id="updateAudit">
        UPDATE `knowledge_feishu_sync_audit`
        SET `status` = #{status},
            `total_count` = #{totalCount},
            `success_count` = #{successCount},
            `failed_count` = #{failedCount},
            `error` = #{error},
            `detail` = #{detailStr},
            `end_time` = NOW(3)
        WHERE `id` = #{id}
    </update>

    <select id="getAuditById" resultType="neatlogic.framework.knowledge.dto.feishu.KnowledgeFeishuSyncAuditVo">
        SELECT `id`, `config_id` AS configId, `direction`, `status`, `total_count` AS totalCount,
               `success_count` AS successCount, `failed_count` AS failedCount, `error`, `detail` AS detailStr,
               `fcu`, `fcd`, `start_time` AS startTime, `end_time` AS endTime
        FROM `knowledge_feishu_sync_audit`
        WHERE `id` = #{value}
    </select>

    <select id="searchAuditCount" resultType="int">
        SELECT COUNT(1)
        FROM `knowledge_feishu_sync_audit`
        WHERE `config_id` = #{configId}
    </select>

    <select id="searchAudit" resultType="neatlogic.framework.knowledge.dto.feishu.KnowledgeFeishuSyncAuditVo">
        SELECT `id`, `config_id` AS configId, `direction`, `status`, `total_count` AS totalCount,
               `success_count` AS successCount, `failed_count` AS failedCount, `error`, `detail` AS detailStr,
               `fcu`, `fcd`, `start_time` AS startTime, `end_time` AS endTime
        FROM `knowledge_feishu_sync_audit`
        WHERE `config_id` = #{configId}
        ORDER BY `fcd` DESC
        <if test="needPage">
            LIMIT #{startNum}, #{pageSize}
        </if>
    </select>

    <select id="getSyncDocumentByNodeToken" resultType="neatlogic.framework.knowledge.dto.feishu.KnowledgeFeishuSyncDocumentVo">
        SELECT `config_id` AS configId, `node_token` AS nodeToken, `obj_token` AS objToken, `obj_type` AS objType,
               `knowledge_document_id` AS knowledgeDocumentId, `knowledge_document_type_uuid` AS knowledgeDocumentTypeUuid,
               `title`, `feishu_update_time` AS feishuUpdateTime, `last_sync_time` AS lastSyncTime
        FROM `knowledge_feishu_sync_document`
        WHERE `config_id` = #{configId}
          AND `node_token` = #{nodeToken}
    </select>

    <select id="getSyncDocumentByDocumentId" resultType="neatlogic.framework.knowledge.dto.feishu.KnowledgeFeishuSyncDocumentVo">
        SELECT `config_id` AS configId, `node_token` AS nodeToken, `obj_token` AS objToken, `obj_type` AS objType,
               `knowledge_document_id` AS knowledgeDocumentId, `knowledge_document_type_uuid` AS knowledgeDocumentTypeUuid,
               `title`, `feishu_update_time` AS feishuUpdateTime, `last_sync_time` AS lastSyncTime
        FROM `knowledge_feishu_sync_document`
        WHERE `knowledge_document_id` = #{value}
    </select>

    <insert id="insertSyncDocument">
        INSERT INTO `knowledge_feishu_sync_document`
        (`config_id`, `node_token`, `obj_token`, `obj_type`, `knowledge_document_id`, `knowledge_document_type_uuid`, `title`, `feishu_update_time`, `last_sync_time`)
        VALUES
        (#{configId}, #{nodeToken}, #{objToken}, #{objType}, #{knowledgeDocumentId}, #{knowledgeDocumentTypeUuid}, #{title}, #{feishuUpdateTime}, NOW(3))
    </insert>

    <update id="updateSyncDocument">
        UPDATE `knowledge_feishu_sync_document`
        SET `obj_token` = #{objToken},
            `obj_type` = #{objType},
            `knowledge_document_id` = #{knowledgeDocumentId},
            `knowledge_document_type_uuid` = #{knowledgeDocumentTypeUuid},
            `title` = #{title},
            `feishu_update_time` = #{feishuUpdateTime},
            `last_sync_time` = NOW(3)
        WHERE `config_id` = #{configId}
          AND `node_token` = #{nodeToken}
    </update>
</mapper>
